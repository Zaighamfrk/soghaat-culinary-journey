import { createContext, useContext, useState, useEffect, type ReactNode } from "react";

type CartItem = {
  id: string;
  name: string;
  price: number;
  quantity: number;
  image?: string;
};

type CartContextType = {
  items: Record<string, CartItem>;
  addItem: (item: { id: string; name: string; price: number; image?: string }) => void;
  removeItem: (id: string) => void;
  updateQuantity: (id: string, quantity: number) => void;
  clearCart: () => void;
  totalItems: number;
  totalPrice: number;
  isOpen: boolean;
  setIsOpen: (open: boolean) => void;
};

const CartContext = createContext<CartContextType | null>(null);

export function CartProvider({ children }: { children: ReactNode }) {
  const [items, setItems] = useState<Record<string, CartItem>>(() => {
    if (typeof window !== "undefined") {
      const saved = localStorage.getItem("soghaat-cart");
      return saved ? JSON.parse(saved) : {};
    }
    return {};
  });
  const [isOpen, setIsOpen] = useState(false);

  useEffect(() => {
    localStorage.setItem("soghaat-cart", JSON.stringify(items));
  }, [items]);

  const addItem = (item: { id: string; name: string; price: number; image?: string }) => {
    setItems((prev) => ({
      ...prev,
      [item.id]: {
        ...item,
        quantity: (prev[item.id]?.quantity ?? 0) + 1,
      },
    }));
    setIsOpen(true);
  };

  const removeItem = (id: string) => {
    setItems((prev) => {
      const next = { ...prev };
      delete next[id];
      return next;
    });
  };

  const updateQuantity = (id: string, quantity: number) => {
    if (quantity < 1) {
      removeItem(id);
      return;
    }
    setItems((prev) => ({
      ...prev,
      [id]: { ...prev[id], quantity },
    }));
  };

  const clearCart = () => setItems({});

  const lines = Object.values(items);
  const totalItems = lines.reduce((sum, i) => sum + i.quantity, 0);
  const totalPrice = lines.reduce((sum, i) => sum + i.price * i.quantity, 0);

  return (
    <CartContext.Provider
      value={{ items, addItem, removeItem, updateQuantity, clearCart, totalItems, totalPrice, isOpen, setIsOpen }}
    >
      {children}
    </CartContext.Provider>
  );
}

export function useCart() {
  const ctx = useContext(CartContext);
  if (!ctx) throw new Error("useCart must be used inside CartProvider");
  return ctx;
}
